NODE_ENV=development
PORT=4000
CORS_ORIGIN="http://localhost:3000"
SWAGGER_ENABLED=true
DATABASE_URL="postgresql://YOUR_MACOS_USERNAME@localhost:5432/hotel_yab"
AUTH_OTP_SECRET="replace-with-at-least-32-random-characters"
AUTH_OTP_TTL_MINUTES=5
AUTH_OTP_RESEND_SECONDS=60
AUTH_SESSION_DAYS=1
# development (local), preview (temporary server code display), disabled, or najva
SMS_PROVIDER=development
NAJVA_API_BASE_URL="https://sms.najva.com"
NAJVA_API_KEY=""
NAJVA_SENDER=""
NAJVA_OTP_TEMPLATE="HotelYabOTPTemplate"
SMS_OTP_ORIGIN_HOST=""
# Moderator-only background processing of reviewed crawler batches.
CRAWL_PROCESSING_ENABLED=false
CRAWL_PROCESSING_REPO_ROOT=""
CRAWL_PROCESSING_PYTHON="python3"
CRAWL_PROCESSING_INSTAGRAM_LOGIN=""
CRAWL_PROCESSING_API_BASE="http://127.0.0.1:4000/api/v1"
