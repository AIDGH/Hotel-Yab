generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotablePersonCategory {
  ACTOR
  ATHLETE
  INFLUENCER
  MUSICIAN
  PUBLIC_FIGURE
}

enum AssociationType {
  STAYED
  VISITED
  ATTENDED_EVENT
  COLLABORATED
  ENDORSED
  OWNED
  FILMED_AT
  OTHER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum SourceType {
  NEWS_ARTICLE
  OFFICIAL_WEBSITE
  SOCIAL_MEDIA_POST
  INTERVIEW
  VIDEO
  PHOTO
  OTHER
}

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum ContentModerationStatus {
  PENDING
  PUBLISHED
  REJECTED
  HIDDEN
}

enum CommentReportReason {
  SPAM
  HARASSMENT
  HATEFUL
  MISINFORMATION
  OTHER
}

enum DestinationType {
  CITY
  PROVINCE
}

enum VideoCategory {
  TRAVEL
  HOTEL
}

enum ContentKind {
  VIDEO
  POST
  STORY
}

enum ContentMediaType {
  IMAGE
  VIDEO
}

enum CrawlReviewBatchStatus {
  REVIEWING
  READY
  COMPLETED
}

enum CrawlReviewItemStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CrawlReviewProcessingStatus {
  IDLE
  RUNNING
  SUCCEEDED
  FAILED
}

model Hotel {
  id                String             @id @default(uuid()) @db.Uuid
  slug              String             @unique @db.VarChar(160)
  name              String             @db.VarChar(200)
  description       String?            @db.Text
  countryCode       String             @db.Char(2)
  city              String             @db.VarChar(120)
  address           String?            @db.Text
  latitude          Decimal?           @db.Decimal(9, 6)
  longitude         Decimal?           @db.Decimal(9, 6)
  websiteUrl        String?            @db.Text
  imageUrl          String?            @db.Text
  logoUrl           String?            @db.Text
  starRating        Int?
  publicationStatus PublicationStatus  @default(DRAFT)
  associations      HotelAssociation[]
  reviews           HotelReview[]
  likes             UserHotelLike[]
  savedBy           UserSavedHotel[]
  videos            VideoHotel[]
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)

  @@index([countryCode, city])
  @@index([publicationStatus])
}

model NotablePerson {
  id                             String                   @id @default(uuid()) @db.Uuid
  slug                           String                   @unique @db.VarChar(160)
  displayName                    String                   @db.VarChar(200)
  instagramHandle                String?                  @db.VarChar(30)
  primaryCategory                NotablePersonCategory
  occupation                     String?                  @db.VarChar(200)
  followerCount                  Int?
  followersUpdatedAt             DateTime?                @db.Timestamptz(3)
  biography                      String?                  @db.Text
  countryCode                    String?                  @db.Char(2)
  imageUrl                       String?                  @db.Text
  instagramCrawlRequest          Json?
  instagramCrawlRequestUpdatedAt DateTime?                @db.Timestamptz(3)
  publicationStatus              PublicationStatus        @default(DRAFT)
  associations                   HotelAssociation[]
  followerSnapshots              FollowerSnapshot[]
  linkedUser                     User?                    @relation("UserNotablePerson")
  likes                          UserNotablePersonLike[]
  savedBy                        UserSavedNotablePerson[]
  createdAt                      DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt                      DateTime                 @updatedAt @db.Timestamptz(3)

  @@index([primaryCategory])
  @@index([publicationStatus])
}

model FollowerSnapshot {
  id              String        @id @default(uuid()) @db.Uuid
  notablePersonId String        @db.Uuid
  followerCount   Int
  snapshotDate    DateTime      @db.Date
  capturedAt      DateTime      @default(now()) @db.Timestamptz(3)
  notablePerson   NotablePerson @relation(fields: [notablePersonId], references: [id], onDelete: Cascade)

  @@unique([notablePersonId, snapshotDate])
  @@index([notablePersonId, capturedAt])
}

model HotelAssociation {
  id                 String                @id @default(uuid()) @db.Uuid
  referenceKey       String                @unique @db.VarChar(200)
  hotelId            String                @db.Uuid
  notablePersonId    String                @db.Uuid
  type               AssociationType
  summary            String                @db.Text
  occurredAt         DateTime?             @db.Timestamptz(3)
  verificationStatus VerificationStatus    @default(PENDING)
  verificationNotes  String?               @db.Text
  verifiedAt         DateTime?             @db.Timestamptz(3)
  hotel              Hotel                 @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  notablePerson      NotablePerson         @relation(fields: [notablePersonId], references: [id], onDelete: Cascade)
  evidence           AssociationEvidence[]
  createdAt          DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(3)

  @@index([hotelId, verificationStatus])
  @@index([notablePersonId, verificationStatus])
  @@index([type])
}

model Source {
  id          String                @id @default(uuid()) @db.Uuid
  url         String                @unique @db.Text
  type        SourceType
  title       String                @db.VarChar(300)
  publisher   String?               @db.VarChar(200)
  author      String?               @db.VarChar(200)
  publishedAt DateTime?             @db.Timestamptz(3)
  archivedUrl String?               @db.Text
  evidence    AssociationEvidence[]
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @db.Timestamptz(3)
}

model AssociationEvidence {
  associationId String           @db.Uuid
  sourceId      String           @db.Uuid
  isPrimary     Boolean          @default(false)
  note          String?          @db.Text
  association   HotelAssociation @relation(fields: [associationId], references: [id], onDelete: Cascade)
  source        Source           @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)

  @@id([associationId, sourceId])
  @@index([sourceId])
}

model User {
  id                     String                   @id @default(uuid()) @db.Uuid
  mobile                 String                   @unique @db.VarChar(16)
  username               String?                  @unique @db.VarChar(30)
  passwordHash           String?                  @db.VarChar(255)
  firstName              String?                  @db.VarChar(80)
  lastName               String?                  @db.VarChar(100)
  email                  String?                  @unique @db.VarChar(254)
  instagramHandle        String?                  @unique @db.VarChar(30)
  role                   UserRole                 @default(USER)
  status                 UserStatus               @default(ACTIVE)
  notablePersonId        String?                  @unique @db.Uuid
  notablePerson          NotablePerson?           @relation("UserNotablePerson", fields: [notablePersonId], references: [id], onDelete: SetNull)
  avatar                 UserAvatar?
  hotelLikes             UserHotelLike[]
  savedHotels            UserSavedHotel[]
  notablePersonLikes     UserNotablePersonLike[]
  savedNotablePeople     UserSavedNotablePerson[]
  sessions               UserSession[]
  hotelReviews           HotelReview[]
  videoComments          VideoComment[]
  videoCommentReports    VideoCommentReport[]     @relation("VideoCommentReporter")
  resolvedCommentReports VideoCommentReport[]     @relation("VideoCommentReportResolver")
  moderatedHotelReviews  HotelReview[]            @relation("HotelReviewModerator")
  moderatedVideoComments VideoComment[]           @relation("VideoCommentModerator")
  createdCrawlReviews    CrawlReviewBatch[]       @relation("CrawlReviewCreatedBy")
  processedCrawlReviews  CrawlReviewBatch[]       @relation("CrawlReviewProcessedBy")
  lastLoginAt            DateTime?                @db.Timestamptz(3)
  createdAt              DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                 @updatedAt @db.Timestamptz(3)

  @@index([status])
}

model UserAvatar {
  userId    String   @id @db.Uuid
  data      Bytes
  mimeType  String   @db.VarChar(32)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model UserHotelLike {
  userId    String   @db.Uuid
  hotelId   String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([userId, hotelId])
  @@index([hotelId])
  @@index([userId, createdAt])
}

model UserSavedHotel {
  userId    String   @db.Uuid
  hotelId   String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([userId, hotelId])
  @@index([hotelId])
  @@index([userId, createdAt])
}

model UserNotablePersonLike {
  userId          String        @db.Uuid
  notablePersonId String        @db.Uuid
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  notablePerson   NotablePerson @relation(fields: [notablePersonId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)

  @@id([userId, notablePersonId])
  @@index([notablePersonId])
  @@index([userId, createdAt])
}

model UserSavedNotablePerson {
  userId          String        @db.Uuid
  notablePersonId String        @db.Uuid
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  notablePerson   NotablePerson @relation(fields: [notablePersonId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)

  @@id([userId, notablePersonId])
  @@index([notablePersonId])
  @@index([userId, createdAt])
}

model UserSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime @db.Timestamptz(3)
  userAgent String?  @db.VarChar(500)
  ipAddress String?  @db.VarChar(64)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model OtpChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  mobile     String    @db.VarChar(16)
  codeHash   String    @db.Char(64)
  attempts   Int       @default(0)
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([mobile, createdAt])
  @@index([expiresAt])
}

model HotelReview {
  id             String                  @id @default(uuid()) @db.Uuid
  hotelId        String                  @db.Uuid
  userId         String                  @db.Uuid
  rating         Int
  body           String                  @db.Text
  status         ContentModerationStatus @default(PENDING)
  moderationNote String?                 @db.Text
  moderatedAt    DateTime?               @db.Timestamptz(3)
  moderatedById  String?                 @db.Uuid
  publishedAt    DateTime?               @db.Timestamptz(3)
  hotel          Hotel                   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  moderator      User?                   @relation("HotelReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  createdAt      DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @db.Timestamptz(3)

  @@unique([hotelId, userId])
  @@index([hotelId, status, createdAt])
  @@index([userId, createdAt])
  @@index([moderatedById, moderatedAt])
}

model Video {
  id                 String             @id @db.VarChar(160)
  videoCategory      VideoCategory      @default(TRAVEL)
  contentKind        ContentKind        @default(VIDEO)
  instagramUsername  String?            @db.VarChar(30)
  platform           String?            @db.VarChar(30)
  personCategory     String?            @db.VarChar(40)
  contentType        String?            @db.VarChar(40)
  sourceUrl          String?            @db.Text
  title              String?            @db.VarChar(240)
  placeName          String?            @db.VarChar(200)
  placeType          String?            @db.VarChar(40)
  publishedDate      String?            @db.VarChar(20)
  captionSummary     String?            @db.Text
  evidenceType       String?            @db.VarChar(40)
  verificationStatus VerificationStatus @default(PENDING)
  notes              String?            @db.Text
  mediaUrl           String?            @db.Text
  thumbnailUrl       String?            @db.Text
  publicationStatus  PublicationStatus  @default(DRAFT)
  comments           VideoComment[]
  mediaItems         VideoMediaItem[]
  destinations       VideoDestination[]
  hotels             VideoHotel[]
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)

  @@index([instagramUsername])
  @@index([videoCategory, publicationStatus])
  @@index([publicationStatus])
}

model VideoMediaItem {
  videoId      String           @db.VarChar(160)
  displayOrder Int
  mediaType    ContentMediaType
  mediaUrl     String           @db.Text
  thumbnailUrl String?          @db.Text
  video        Video            @relation(fields: [videoId], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)

  @@id([videoId, displayOrder])
  @@index([mediaType])
}

model Destination {
  id                String             @id @default(uuid()) @db.Uuid
  type              DestinationType
  slug              String             @db.VarChar(160)
  name              String             @db.VarChar(200)
  description       String?            @db.Text
  imageUrl          String?            @db.Text
  parentProvinceId  String?            @db.Uuid
  parentProvince    Destination?       @relation("ProvinceCities", fields: [parentProvinceId], references: [id], onDelete: SetNull)
  cities            Destination[]      @relation("ProvinceCities")
  isFeatured        Boolean            @default(false)
  displayOrder      Int?
  primarySourceUrl  String?            @db.Text
  sourceType        String?            @db.VarChar(60)
  notes             String?            @db.Text
  publicationStatus PublicationStatus  @default(DRAFT)
  videos            VideoDestination[]
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)

  @@unique([type, slug])
  @@unique([type, displayOrder])
  @@index([parentProvinceId])
  @@index([publicationStatus, type, displayOrder])
}

model VideoDestination {
  videoId       String      @db.VarChar(160)
  destinationId String      @db.Uuid
  video         Video       @relation(fields: [videoId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  @@id([videoId, destinationId])
  @@index([destinationId])
}

model VideoHotel {
  videoId   String   @db.VarChar(160)
  hotelId   String   @db.Uuid
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@id([videoId, hotelId])
  @@index([hotelId])
}

model VideoComment {
  id             String                  @id @default(uuid()) @db.Uuid
  videoId        String                  @db.VarChar(160)
  userId         String                  @db.Uuid
  parentId       String?                 @db.Uuid
  body           String                  @db.Text
  status         ContentModerationStatus @default(PENDING)
  moderationNote String?                 @db.Text
  moderatedAt    DateTime?               @db.Timestamptz(3)
  moderatedById  String?                 @db.Uuid
  publishedAt    DateTime?               @db.Timestamptz(3)
  video          Video                   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  moderator      User?                   @relation("VideoCommentModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  parent         VideoComment?           @relation("VideoCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        VideoComment[]          @relation("VideoCommentReplies")
  reports        VideoCommentReport[]
  createdAt      DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @db.Timestamptz(3)

  @@index([videoId, status, createdAt])
  @@index([userId, createdAt])
  @@index([parentId])
  @@index([moderatedById, moderatedAt])
}

model VideoCommentReport {
  id           String              @id @default(uuid()) @db.Uuid
  commentId    String              @db.Uuid
  reporterId   String              @db.Uuid
  reason       CommentReportReason
  details      String?             @db.VarChar(500)
  resolvedAt   DateTime?           @db.Timestamptz(3)
  resolvedById String?             @db.Uuid
  comment      VideoComment        @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter     User                @relation("VideoCommentReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy   User?               @relation("VideoCommentReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)

  @@unique([commentId, reporterId])
  @@index([commentId, resolvedAt])
  @@index([reporterId, createdAt])
  @@index([resolvedById, resolvedAt])
}

model CrawlReviewBatch {
  id                   String                      @id @default(uuid()) @db.Uuid
  instagramUsername    String                      @db.VarChar(30)
  sourceFilename       String                      @db.VarChar(255)
  contentHash          String                      @unique @db.Char(64)
  status               CrawlReviewBatchStatus      @default(REVIEWING)
  processingStatus     CrawlReviewProcessingStatus @default(IDLE)
  processingStartedAt  DateTime?                   @db.Timestamptz(3)
  processingFinishedAt DateTime?                   @db.Timestamptz(3)
  processingLog        String?                     @db.Text
  createdById          String                      @db.Uuid
  createdBy            User                        @relation("CrawlReviewCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  processedById        String?                     @db.Uuid
  processedBy          User?                       @relation("CrawlReviewProcessedBy", fields: [processedById], references: [id], onDelete: SetNull)
  reviewedAt           DateTime?                   @db.Timestamptz(3)
  completedAt          DateTime?                   @db.Timestamptz(3)
  items                CrawlReviewItem[]
  createdAt            DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                    @updatedAt @db.Timestamptz(3)

  @@index([status, updatedAt])
  @@index([processingStatus, updatedAt])
  @@index([instagramUsername, createdAt])
  @@index([createdById, createdAt])
  @@index([processedById, processingStartedAt])
}

model CrawlReviewItem {
  id                String                @id @default(uuid()) @db.Uuid
  batchId           String                @db.Uuid
  displayOrder      Int
  sourceUrl         String                @db.Text
  shortcode         String                @db.VarChar(80)
  instagramUsername String                @db.VarChar(30)
  reviewStatus      CrawlReviewItemStatus @default(PENDING)
  hotelId           String?               @db.Uuid
  hotelName         String?               @db.VarChar(200)
  cityIds           String[]              @db.Uuid
  provinceIds       String[]              @db.Uuid
  finalTitle        String?               @db.VarChar(240)
  placeName         String?               @db.VarChar(200)
  placeType         String?               @db.VarChar(40)
  contentType       String?               @db.VarChar(40)
  captionSummary    String?               @db.Text
  notes             String?               @db.Text
  publishedAt       String?               @db.VarChar(40)
  rawPayload        Json
  batch             CrawlReviewBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @db.Timestamptz(3)

  @@unique([batchId, sourceUrl])
  @@index([batchId, displayOrder])
  @@index([batchId, reviewStatus])
}
